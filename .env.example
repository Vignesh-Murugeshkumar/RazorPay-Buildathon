# 🛡️ SentinelDispute Environment Configuration

# Razorpay Webhook Secret (Matches secret in Razorpay Dashboard -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=sentinel_secret_key_dev
WEBHOOK_SECRET=sentinel_secret_key_dev

# Optional Redis Connection (For Hot-Tier Telemetry Cache)
# If left empty, SentinelDispute automatically uses its built-in In-Memory Sliding Cache
# Example: redis://localhost:6379/0 or rediss://default:PASSWORD@your-redis-host:6379
REDIS_URL=

# Supabase / PostgreSQL Connection String (For Cold-Tier Telemetry & Audit Logs)
# If left empty, SentinelDispute automatically uses its embedded local SQLite database (sentinel_dispute.db)
# Example: postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Environment & Logging
ENVIRONMENT=development
LOG_LEVEL=INFO

